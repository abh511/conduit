.DEFAULT_GOAL := help
.PHONY: help install dev up down logs lint fmt typecheck test test-unit test-integration check migrate revision

help: ## Show available commands
	@grep -E '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-18s\033[0m %s\n", $$1, $$2}'

install: ## Create .venv with all deps and install git hooks
	uv sync
	uv run pre-commit install

dev: ## Run the API on the host with auto-reload (needs: docker compose up -d postgres redis)
	CONDUIT_LOG_FORMAT=console uv run uvicorn app.main:create_app --factory --reload --port 8000

up: ## Build and start the full stack (postgres, redis, migrate, api)
	docker compose up -d --build

down: ## Stop the stack (data volumes are kept)
	docker compose down

logs: ## Follow API logs
	docker compose logs -f api

lint: ## Lint and check formatting
	uv run ruff check .
	uv run ruff format --check .

fmt: ## Auto-fix lint issues and format
	uv run ruff check --fix .
	uv run ruff format .

typecheck: ## Static type check
	uv run mypy

test: ## All tests with coverage (integration tests need Docker)
	uv run pytest --cov --cov-report=term-missing

test-unit: ## Unit tests only, no Docker needed
	uv run pytest -m "not integration"

test-integration: ## Integration tests only (testcontainers)
	uv run pytest -m integration

check: lint typecheck test ## Everything CI runs

migrate: ## Apply migrations to CONDUIT_DATABASE_URL
	uv run alembic upgrade head

revision: ## New autogenerated migration: make revision m="add tenants"
	uv run alembic revision --autogenerate -m "$(m)"
