# Copy to .env for local development (`cp .env.example .env`).
# Values here are for running the app on your host machine (`make dev`) against
# the Postgres/Redis containers from `docker compose up postgres redis`.

CONDUIT_ENVIRONMENT=dev
CONDUIT_LOG_LEVEL=INFO
CONDUIT_DATABASE_URL=postgresql+asyncpg://conduit:conduit@localhost:5432/conduit
CONDUIT_REDIS_URL=redis://localhost:6379/0
CONDUIT_LOG_FORMAT=json          # or "console" for readable local output

# Provider API keys. Leave empty to disable a provider; "mock" always works.
# Groq: https://console.groq.com/keys   OpenRouter: https://openrouter.ai/keys
CONDUIT_GROQ_API_KEY=
CONDUIT_OPENROUTER_API_KEY=

# Mock provider behaviour
CONDUIT_MOCK_LATENCY_MS=20
CONDUIT_MOCK_FAILURE_RATE=0

# Used by docker-compose.yml for the postgres container
POSTGRES_USER=conduit
POSTGRES_PASSWORD=conduit
POSTGRES_DB=conduit
